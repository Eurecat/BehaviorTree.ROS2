<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Action ID="UPOTakeOff" name="TakeOff" action="/TakeOff" state="toffs" takeoff_height.data="5.0"/>
            <ForceSuccess>
                <ReactiveSequence>
                    <Inverter>
                        <SubTree ID="CheckResetRequest" reset_requested="is_reset"/>
                    </Inverter>
                    <Action ID="InfoLog" message="${is_reset}"/>
                    <SequenceStar>
                        <Action ID="UPOGoToGoalByName" goal_name="floor_1_approach" name="ApproachFloor1" action="/Make_Plan" state="gts"/>
                        <ForceSuccess>
                            <SubTree fire_found="fire_wp" ID="ExtinguishFacadeFire"/>
                        </ForceSuccess>
                        <Action ID="InfoLog" message="${fire_wp}"/>
                    </SequenceStar>
                </ReactiveSequence>
            </ForceSuccess>
            <ForceSuccess>
                <Action ID="UPOGoToGoalByName" goal_name="floor_1_retreat" name="RetreatFromFloor1" action="/Make_Plan" state="f2rs"/>
            </ForceSuccess>
            <RetryUntilSuccesful num_attempts="2">
                <Sequence>
                    <Action ID="UPOGoToGoalByName" goal_name="m210_home" name="GoToHome" action="/Make_Plan" state="gths"/>
                    <Action ID="UPOLanding" action="/Landing" state="ls" land="true"/>
                </Sequence>
            </RetryUntilSuccesful>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckFireAndExtinguish">
        <Sequence>
            <Action ID="UPOGoToGoalByName" goal_name="${fire}" action="${actgoto}" state="gts"/>
            <Action ID="UPOFireExtinguish" serialized_result="fer" action="${actextinguish}" state="fes" serialized_feedback="fef" detect_fire="true"/>
            <SetBlackboard output_key="found_fire" value="${fire}"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckResetRequest">
        <Sequence>
            <SetBlackboard output_key="reset_requested" value="false"/>
            <Action serialized_output="m_reset" consume_msgs="true" ID="MonitorStdBool" topic="/reset" queue_size="1"/>
            <Action ID="ConvertMessageField" input="${m_reset}" output="mission_reset" field="/data"/>
            <Action ID="InfoLog" message="${mission_reset}"/>
            <Condition ID="CheckBool" input="${mission_reset}"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="ExtinguishFacadeFire">
        <Sequence>
            <SetBlackboard output_key="fire_found" value="none"/>
            <Fallback>
                <SubTree found_fire="fire_found" ID="CheckFireAndExtinguish" actgoto="/Make_Plan" actextinguish="/wall_fire_extinguisher" fire="floor_1_fire_1"/>
                <SubTree found_fire="fire_found" ID="CheckFireAndExtinguish" actgoto="/Make_Plan" actextinguish="/wall_fire_extinguisher" fire="floor_1_fire_2"/>
                <SubTree found_fire="fire_found" ID="CheckFireAndExtinguish" actgoto="/Make_Plan" actextinguish="/wall_fire_extinguisher" fire="floor_1_fire_3"/>
                <SubTree found_fire="fire_found" ID="CheckFireAndExtinguish" actgoto="/Make_Plan" actextinguish="/wall_fire_extinguisher" fire="floor_1_fire_4"/>
		<SubTree found_fire="fire_found" ID="CheckFireAndExtinguish" actgoto="/Make_Plan" actextinguish="/wall_fire_extinguisher" fire="floor_1_fire_5"/>
                <SubTree found_fire="fire_found" ID="CheckFireAndExtinguish" actgoto="/Make_Plan" actextinguish="/wall_fire_extinguisher" fire="floor_1_fire_6"/>
                <SubTree found_fire="fire_found" ID="CheckFireAndExtinguish" actgoto="/Make_Plan" actextinguish="/wall_fire_extinguisher" fire="floor_1_fire_7"/>
                <SubTree found_fire="fire_found" ID="CheckFireAndExtinguish" actgoto="/Make_Plan" actextinguish="/wall_fire_extinguisher" fire="floor_1_fire_8"/>
            </Fallback>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="CallEmptyService">
            <input_port name="service" type="std::string">ROS service name</input_port>
        </Action>
        <Condition ID="CheckBool">
            <input_port name="input" type="bool">Input boolean value</input_port>
        </Condition>
        <SubTree ID="CheckFireAndExtinguish">
            <input_port name="actextinguish">Extinguish Action Name</input_port>
            <input_port name="actgoto">GoTo Action Name</input_port>
            <input_port name="fire">Fire waypoint</input_port>
            <output_port name="found_fire">Name of the Fire WP if found</output_port>
        </SubTree>
        <Action ID="CheckKey">
            <input_port name="no_key" type="std::string">Key to determine if key to say 'no' has benn pressed</input_port>
            <input_port name="yes_key" type="std::string">Key to determine if key to say 'yes' has been pressed</input_port>
        </Action>
        <SubTree ID="CheckResetRequest">
