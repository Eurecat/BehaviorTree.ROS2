<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Action action="/TakeOff" ID="UPOTakeOff" takeoff_height.data="7.0" state="tos"/>
            <Action duration="3" ID="WaitSeconds"/>
            <ForceSuccess>
	    	<Sequence>
                	<Action action="/Make_Plan" goal_name="blue_facade_approach_1" ID="UPOGoToGoalByName" name="ApproachBlueFacade" state="gts"/>
            		<Action duration="3" ID="WaitSeconds"/>
			<SubTree actextinguish="/wall_fire_extinguisher" actgoto="/Make_Plan" found_fire="fire_found" fire="blue_fire_3" ID="CheckFireAndExtinguish"/>
			<Action action="/Make_Plan" goal_name="blue_facade_retreat" ID="UPOGoToGoalByName" name="RetreatFromBlueFacade" state="f2rs"/>
		</Sequence>
            </ForceSuccess>
            <Action duration="3" ID="WaitSeconds"/>
            <RetryUntilSuccesful num_attempts="2">
                <SubTree ID="GoToAndLand" waypoint="m600_home"/>
            </RetryUntilSuccesful>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="BlanketExploreAndExtinguish">
        <SequenceStar>
            <Parallel threshold="1">
                <SubTree ID="OutsideExplorationPath"/>
                <Action fire_found="fd_found" z="fd_z" action="/firedetection3D_bottom" duration="120" ID="UPOFireDetection3D" name="DetectFire" y="fd_y" x="fd_x" state="fd_s"/>
            </Parallel>
            <Condition input="${fd_found}" ID="CheckBool"/>
            <Action message="${fd_found}" ID="InfoLog"/>
            <Action first="${fd_z}" second="3.0" output="final_z" ID="MathOperationFloat" operator="+"/>
            <Action duration="3" ID="WaitSeconds"/>
            <Action global_goal.pose.position.x="${fd_x}" action="/Make_Plan" ID="UPOGoToGoal" name="GoToFire" global_goal.header.seq="1" global_goal.pose.orientation.z="0.0" global_goal.header.frame_id="/world" global_goal.pose.orientation.w="1.0" global_goal.pose.position.y="${fd_y}" global_goal.pose.position.z="${final_z}" global_goal.pose.orientation.y="0.0" state="gtfs" global_goal.pose.orientation.x="0.0"/>
            <Action duration="3" ID="WaitSeconds"/>
            <Action action="/blanket_fire_extinguisher" ID="UPOFireExtinguish" name="ExtinguishFire" serialized_result="ef_r" detect_fire="true" serialized_feedback="ef_f" state="ef_s"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckFireAndExtinguish">
        <Sequence>
            <Action duration="3" ID="WaitSeconds"/>
            <Action action="${actgoto}" goal_name="${fire}" ID="UPOGoToGoalByName" name="GoToFire" state="gts"/>
            <Action action="${actextinguish}" ID="UPOFireExtinguish" name="ExtinguishFire" serialized_result="fer" detect_fire="true" serialized_feedback="fef" state="fes"/>
            <SetBlackboard value="${fire}" output_key="found_fire"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckResetRequest">
        <Sequence>
            <SetBlackboard value="false" output_key="reset_requested"/>
            <Action topic="/reset" ID="MonitorStdBool" consume_msgs="true" serialized_output="m_reset" queue_size="1"/>
            <Action input="${m_reset}" output="mission_reset" ID="ConvertMessageField" field="/data"/>
            <Action message="${mission_reset}" ID="InfoLog"/>
            <Condition input="${mission_reset}" ID="CheckBool"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="ExtinguishFacadeFire">
        <Sequence>
            <SetBlackboard value="none" output_key="fire_found"/>
            <Fallback>
                <SubTree actextinguish="/wall_fire_extinguisher" actgoto="/Make_Plan" found_fire="fire_found" fire="blue_fire_2" ID="CheckFireAndExtinguish"/>
                <Sequence>
                    <Action action="/Make_Plan" goal_name="blue_facade_retreat" ID="UPOGoToGoalByName" name="GoToRetreat2" state="lfr2s"/>
                    <SubTree actextinguish="/wall_fire_extinguisher" actgoto="/Make_Plan" found_fire="fire_found" fire="blue_fire_5" ID="CheckFireAndExtinguish"/>
                </Sequence>
                <Sequence>
                    <Action action="/Make_Plan" goal_name="blue_facade_retreat" ID="UPOGoToGoalByName" state="lfr3s"/>
                    <SubTree actextinguish="/wall_fire_extinguisher" actgoto="/Make_Plan" found_fire="fire_found" fire="blue_fire_3" ID="CheckFireAndExtinguish"/>
                </Sequence>
                <Sequence>
                    <Action action="/Make_Plan" goal_name="blue_facade_retreat" ID="UPOGoToGoalByName" name="RetreatFromSecondFloor" state="sffrs"/>
                    <SubTree actextinguish="/wall_fire_extinguisher" actgoto="/Make_Plan" found_fire="fire_found" fire="blue_fire_4" ID="CheckFireAndExtinguish"/>
                </Sequence>
                <Sequence>
		    <Action action="/Make_Plan" goal_name="blue_facade_retreat" ID="UPOGoToGoalByName" name="RetreatFromSecondFloor" state="sffrs1"/>
                    <SubTree actextinguish="/wall_fire_extinguisher" actgoto="/Make_Plan" found_fire="fire_found" fire="blue_fire_1" ID="CheckFireAndExtinguish"/>
                </Sequence>
            </Fallback>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="FireOutsideMission">
        <SequenceStar>
            <ForceSuccess>
                <SubTree ID="BlanketExploreAndExtinguish"/>
            </ForceSuccess>
            <Action duration="5" ID="WaitSeconds"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="GoToAndLand">
        <SequenceStar>
            <Action action="/Make_Plan" goal_name="${waypoint}" ID="UPOGoToGoalByName" name="GoToPointForLanding" state="g1s"/>
            <Action duration="5" ID="WaitSeconds"/>
            <Action land="true" action="/Landing" ID="UPOLanding" name="Land" state="lds"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="LeftFacadeMission">
        <SequenceStar>
            <Action action="/Make_Plan" goal_name="blue_facade_approach_1" ID="UPOGoToGoalByName" name="ApproachBlueFacade" state="gts"/>
            <Action duration="3" ID="WaitSeconds"/>
            <ForceSuccess>
                <SubTree fire_found="fire_wp" ID="ExtinguishFacadeFire"/>
            </ForceSuccess>
            <Action message="${fire_wp}" ID="InfoLog"/>
            <Action duration="3" ID="WaitSeconds"/>
            <Action action="/Make_Plan" goal_name="blue_facade_retreat" ID="UPOGoToGoalByName" name="RetreatFromBlueFacade" state="f2rs"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="OutsideExplorationPath">
        <Sequence>
            <Action duration="3" ID="WaitSeconds"/>
            <Action action="/Make_Plan" goal_name="outside_fire_2" ID="UPOGoToGoalByName" name="GoToGoal2" state="gtg2s"/>
            <Action duration="3" ID="WaitSeconds"/>
            <Action action="/Make_Plan" goal_name="outside_fire_3" ID="UPOGoToGoalByName" name="GoToGoal3" state="gtg3s"/>
            <Action duration="3" ID="WaitSeconds"/>
            <Action action="/Make_Plan" goal_name="outside_fire_4" ID="UPOGoToGoalByName" name="GoToGoal4" state="gtg4s"/>
            <Action duration="3" ID="WaitSeconds"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <SubTree ID="BlanketExploreAndExtinguish"/>
        <Action ID="CallEmptyService">
            <input_port name="service" type="std::string">ROS service name</input_port>
        </Action>
        <Condition ID="CheckBool">
            <input_port name="input" type="bool">Input boolean value</input_port>
        </Condition>
        <SubTree ID="CheckFireAndExtinguish">
            <input_port name="actextinguish">Extinguish Action Name</input_port>
            <input_port name="actgoto">GoTo Action Name</input_port>
            <input_port name="fire">Fire waypoint</input_port>
            <output_port name="found_fire">Name of the Fire WP if found</output_port>
        </SubTree>
        <Action ID="CheckKey">
            <input_port name="no_key" type="std::string">Key to determine if key to say 'no' has benn pressed</input_port>
            <input_port name="yes_key" type="std::string">Key to determine if key to say 'yes' has been pressed</input_port>
        </Action>
        <SubTree ID="CheckResetRequest">
            <output_port name="reset_requested"/>
        </SubTree>
        <Condition ID="CompareNumbers">
            <input_port name="comparison_op" type="std::string">Comparison operator. Valid operators are &lt;, >, &lt;=, >=, == and !=</input_port>
            <input_port name="first" type="double">First operand</input_port>
            <input_port name="second" type="double">Second operand</input_port>
        </Condition>
        <Condition ID="CompareStrings">
            <input_port name="comparison_op" type="std::string">Comparison operator. Valid operators are &lt;, >, &lt;=, >=, == and !=</input_port>
            <input_port name="first" type="std::string">First operand</input_port>
            <input_port name="second" type="std::string">Second operand</input_port>
        </Condition>
        <Action ID="ConcatenateStrings">
            <input_port name="first" type="std::string">First string</input_port>
            <output_port name="output" type="std::string">Concatenated result string</output_port>
            <input_port name="second" type="std::string">Second string</input_port>
        </Action>
        <Action ID="ConvertJsonToDouble">
            <input_port name="input" type="nlohmann::basic_json&lt;std::map, std::vector, std::__cxx11::basic_string&lt;char, std::char_traits&lt;char>, std::allocator&lt;char> >, bool, long, unsigned long, double, std::allocator, nlohmann::adl_serializer>">Serialized ROS message</input_port>
            <output_port name="output" type="double">Output variable</output_port>
