<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Fallback>
                <SubTree window="floor_0_door_1" action="/siar/Make_Plan" ID="CheckWindowandEnter" out_win="window_out"/>
                <SubTree window="floor_0_door_2" action="/siar/Make_Plan" ID="CheckWindowandEnter" out_win="window_out"/>
            </Fallback>
            <Action message="${window_out}" ID="InfoLog"/>
            <ForceSuccess>
                <SubTree ID="Floor0ExploreAndExtinguish"/>
            </ForceSuccess>
            <RetryUntilSuccesful num_attempts="2">
                <SubTree window="${window_out}" ID="ExitBuilding" robot_action="/siar/Make_Plan"/>
            </RetryUntilSuccesful>
            <Action state="gth_s" action="/siar/Make_Plan" goal_name="siar_home" ID="UPOGoToGoalByName" name="GoToHome"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckWindowandEnter">
        <Sequence>
            <Action state="dummy" action="${action}" goal_name="${window}" ID="UPOGoToGoalByName"/>
            <Action output="goal_in" second="_in" ID="ConcatenateStrings" first="${window}"/>
            <Action state="dummy" action="${action}" goal_name="${goal_in}" ID="UPOGoToGoalByName"/>
            <SetBlackboard value="${window}" output_key="out_win"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="ExitBuilding">
        <SequenceStar>
            <Action output="goal_to_exit" second="_in_to_out" ID="ConcatenateStrings" name="PrepareToExit" first="${window}"/>
            <Action state="gtwo_result" action="${robot_action}" goal_name="${goal_to_exit}" ID="UPOGoToGoalByName" name="GoToWindowOut"/>
            <Action output="goal_outside" second="_out" ID="ConcatenateStrings" first="${window}"/>
            <Action state="gte_result" action="${robot_action}" goal_name="${goal_outside}" ID="UPOGoToGoalByName" name="GoToExit"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Floor0ExplorationPath">
        <Sequence>
            <Action state="gtg1s" action="/siar/Make_Plan" goal_name="floor_0_explore_1" ID="UPOGoToGoalByName" name="GoToGoal1"/>
            <Action state="gtg2s" action="/siar/Make_Plan" goal_name="floor_0_explore_2" ID="UPOGoToGoalByName" name="GoToGoal2"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Floor0ExploreAndExtinguish">
        <Sequence>
            <Parallel threshold="1">
                <SubTree ID="Floor0ExplorationPath"/>
                <Action x="fd_x" z="fd_z" fire_found="fd_found" y="fd_y" state="fd_s" action="/siar/firedetection3D" ID="UPOFireDetection3D" duration="15" name="DetectFire"/>
            </Parallel>
            <Condition input="${fd_found}" ID="CheckBool"/>
            <Action message="${fd_found}" ID="InfoLog"/>
            <Action global_goal.header.frame_id="/world" global_goal.header.seq="1" global_goal.pose.orientation.y="0.0" global_goal.pose.orientation.x="0.0" global_goal.pose.position.y="${fd_y}" global_goal.pose.orientation.z="0.0" global_goal.pose.position.z="${fd_z}" state="gtfs" action="/siar/Make_Plan" ID="UPOGoToGoal" global_goal.pose.position.x="${fd_x}" name="GoToFire" global_goal.pose.orientation.w="1.0"/>
            <Action state="ef_s" action="/siar/fire_extinguisher" serialized_result="ef_r" ID="UPOFireExtinguish" serialized_feedback="ef_f" name="ExtinguishFire" detect_fire="true"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="CallEmptyService">
            <input_port type="std::string" name="service">ROS service name</input_port>
        </Action>
        <Condition ID="CheckBool">
            <input_port type="bool" name="input">Input boolean value</input_port>
        </Condition>
        <Action ID="CheckKey">
            <input_port type="std::string" name="no_key">Key to determine if key to say 'no' has benn pressed</input_port>
            <input_port type="std::string" name="yes_key">Key to determine if key to say 'yes' has been pressed</input_port>
        </Action>
        <SubTree ID="CheckWindowandEnter">
            <input_port name="action"/>
            <output_port name="out_win"/>
            <input_port name="window"/>
        </SubTree>
        <Condition ID="CompareNumbers">
            <input_port type="std::string" name="comparison_op">Comparison operator. Valid operators are &lt;, >, &lt;=, >=, == and !=</input_port>
            <input_port type="double" name="first">First operand</input_port>
            <input_port type="double" name="second">Second operand</input_port>
        </Condition>
        <Condition ID="CompareStrings">
            <input_port type="std::string" name="comparison_op">Comparison operator. Valid operators are &lt;, >, &lt;=, >=, == and !=</input_port>
            <input_port type="std::string" name="first">First operand</input_port>
            <input_port type="std::string" name="second">Second operand</input_port>
