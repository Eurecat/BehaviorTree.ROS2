<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Action ID="WaitSeconds" duration="30"/>
            <Action ID="UPOTakeOff" state="tos" action="/TakeOff" takeoff_height.data="4.0"/>
            <Action ID="WaitSeconds" duration="3"/>
            <ForceSuccess>
                <SubTree ID="FireOutsideMission"/>
            </ForceSuccess>
            <Action ID="PublishBool" latch="0" data="false" queue_size="1" topic="/unroll_blanket"/>
	    <Action ID="WaitSeconds" duration="1"/>
            <Action ID="PublishBool" latch="0" data="false" queue_size="1" topic="/drop_blanket"/>
            <ForceSuccess>
                <SubTree ID="LeftFacadeMission"/>
            </ForceSuccess>
            <Action ID="PublishBool" latch="0" data="true" queue_size="1" topic="/unroll_blanket"/>
            <Action ID="PublishBool" latch="0" data="true" queue_size="1" topic="/drop_blanket"/>
            <Action ID="WaitSeconds" duration="3"/>
            <RetryUntilSuccesful num_attempts="2">
                <SubTree ID="GoToAndLand" waypoint="m600_home"/>
            </RetryUntilSuccesful>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="BlanketExploreAndExtinguish">
        <SequenceStar>
            <Parallel threshold="1">
                <SubTree ID="OutsideExplorationPath"/>
                <Action ID="UPOFireDetection3D" fire_found="fd_found" name="DetectFire" y="fd_y" z="fd_z" duration="120" state="fd_s" action="/firedetection3D_bottom" x="fd_x"/>
            </Parallel>
            <Condition ID="CheckBool" input="${fd_found}"/>
            <Action ID="InfoLog" message="${fd_found}"/>
            <Action ID="MathOperationFloat" first="${fd_z}" second="3.0" output="final_z" operator="+"/>
            <Action ID="WaitSeconds" duration="3"/>
            <Action ID="UPOGoToGoal" global_goal.pose.orientation.w="1.0" global_goal.pose.orientation.y="0.0" name="GoToFire" global_goal.pose.position.z="${final_z}" global_goal.header.seq="1" global_goal.pose.position.x="${fd_x}" global_goal.header.frame_id="/world" global_goal.pose.orientation.z="0.0" global_goal.pose.orientation.x="0.0" state="gtfs" global_goal.pose.position.y="${fd_y}" action="/Make_Plan"/>
            <Action ID="WaitSeconds" duration="3"/>
            <Action ID="UPOFireExtinguish" name="ExtinguishFire" detect_fire="true" serialized_feedback="ef_f" serialized_result="ef_r" state="ef_s" action="/blanket_fire_extinguisher"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckFireAndExtinguish">
        <Sequence>
            <Action ID="WaitSeconds" duration="3"/>
            <Action ID="UPOGoToGoalByName" name="GoToFire" goal_name="${fire}" state="gts" action="${actgoto}"/>
            <Action ID="UPOFireExtinguish" name="ExtinguishFire" detect_fire="true" serialized_feedback="fef" serialized_result="fer" state="fes" action="${actextinguish}"/>
            <SetBlackboard value="${fire}" output_key="found_fire"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckResetRequest">
        <Sequence>
            <SetBlackboard value="false" output_key="reset_requested"/>
            <Action ID="MonitorStdBool" serialized_output="m_reset" consume_msgs="true" queue_size="1" topic="/reset"/>
            <Action ID="ConvertMessageField" field="/data" output="mission_reset" input="${m_reset}"/>
            <Action ID="InfoLog" message="${mission_reset}"/>
            <Condition ID="CheckBool" input="${mission_reset}"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="ExtinguishFacadeFire">
        <Sequence>
            <SetBlackboard value="none" output_key="fire_found"/>
            <ForceSuccess>
                <SubTree ID="CheckFireAndExtinguish" actgoto="/Make_Plan" found_fire="fire_found" actextinguish="/wall_fire_extinguisher" fire="blue_fire_1"/>
            </ForceSuccess>
            <Action ID="UPOGoToGoalByName" name="GoToRetreat1" goal_name="blue_facade_retreat" state="lfrs" action="/Make_Plan"/>
            <ForceSuccess>
                <Fallback>
                    <SubTree ID="CheckFireAndExtinguish" actgoto="/Make_Plan" found_fire="fire_found" actextinguish="/wall_fire_extinguisher" fire="blue_fire_4"/>
                    <Sequence>
                        <Action ID="UPOGoToGoalByName" name="GoToRetreat2" goal_name="blue_facade_retreat" state="lfr2s" action="/Make_Plan"/>
                        <SubTree ID="CheckFireAndExtinguish" actgoto="/Make_Plan" found_fire="fire_found" actextinguish="/wall_fire_extinguisher" fire="blue_fire_3"/>
                    </Sequence>
                    <Sequence>
                        <Action ID="UPOGoToGoalByName" goal_name="blue_facade_retreat" state="lfr3s" action="/Make_Plan"/>
                        <SubTree ID="CheckFireAndExtinguish" actgoto="/Make_Plan" found_fire="fire_found" actextinguish="/wall_fire_extinguisher" fire="blue_fire_5"/>
                    </Sequence>
                </Fallback>
            </ForceSuccess>
            <Action ID="UPOGoToGoalByName" name="RetreatFromSecondFloor" goal_name="blue_facade_retreat" state="sffrs" action="/Make_Plan"/>
            <SubTree ID="CheckFireAndExtinguish" actgoto="/Make_Plan" found_fire="fire_found" actextinguish="/wall_fire_extinguisher" fire="blue_fire_2"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="FireOutsideMission">
        <SequenceStar>
            <ForceSuccess>
                <SubTree ID="BlanketExploreAndExtinguish"/>
            </ForceSuccess>
            <Action ID="WaitSeconds" duration="5"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="GoToAndLand">
        <SequenceStar>
            <Action ID="UPOGoToGoalByName" name="GoToPointForLanding" goal_name="${waypoint}" state="g1s" action="/Make_Plan"/>
            <Action ID="WaitSeconds" duration="5"/>
            <Action ID="UPOLanding" name="Land" state="lds" action="/Landing" land="true"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="LeftFacadeMission">
        <SequenceStar>
            <ForceSuccess>
                <SubTree ID="ExtinguishFacadeFire" fire_found="fire_wp"/>
            </ForceSuccess>
            <Action ID="InfoLog" message="${fire_wp}"/>
            <Action ID="WaitSeconds" duration="3"/>
            <Action ID="UPOGoToGoalByName" name="RetreatFromBlueFacade" goal_name="blue_facade_retreat" state="f2rs" action="/Make_Plan"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="OutsideExplorationPath">
        <Sequence>
            <Action ID="WaitSeconds" duration="3"/>
            <Action ID="UPOGoToGoalByName" name="GoToGoal4" goal_name="outside_fire_4" state="gtg2s" action="/Make_Plan"/>
            <Action ID="WaitSeconds" duration="3"/>
            <Action ID="UPOGoToGoalByName" name="GoToGoal3" goal_name="outside_fire_3" state="gtg3s" action="/Make_Plan"/>
            <Action ID="WaitSeconds" duration="3"/>
            <Action ID="UPOGoToGoalByName" name="GoToGoal2" goal_name="outside_fire_2" state="gtg4s" action="/Make_Plan"/>
            <Action ID="WaitSeconds" duration="3"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <SubTree ID="BlanketExploreAndExtinguish"/>
        <Action ID="CallEmptyService">
            <input_port type="std::string" name="service">ROS service name</input_port>
        </Action>
        <Condition ID="CheckBool">
            <input_port type="bool" name="input">Input boolean value</input_port>
        </Condition>
        <SubTree ID="CheckFireAndExtinguish">
            <input_port name="actextinguish">Extinguish Action Name</input_port>
            <input_port name="actgoto">GoTo Action Name</input_port>
            <input_port name="fire">Fire waypoint</input_port>
            <output_port name="found_fire">Name of the Fire WP if found</output_port>
        </SubTree>
        <Action ID="CheckKey">
            <input_port type="std::string" name="no_key">Key to determine if key to say 'no' has benn pressed</input_port>
            <input_port type="std::string" name="yes_key">Key to determine if key to say 'yes' has been pressed</input_port>
        </Action>
        <SubTree ID="CheckResetRequest">
            <output_port name="reset_requested"/>
        </SubTree>
        <Condition ID="CompareNumbers">
            <input_port type="std::string" name="comparison_op">Comparison operator. Valid operators are &lt;, >, &lt;=, >=, == and !=</input_port>
            <input_port type="double" name="first">First operand</input_port>
            <input_port type="double" name="second">Second operand</input_port>
        </Condition>
        <Condition ID="CompareStrings">
            <input_port type="std::string" name="comparison_op">Comparison operator. Valid operators are &lt;, >, &lt;=, >=, == and !=</input_port>
            <input_port type="std::string" name="first">First operand</input_port>
            <input_port type="std::string" name="second">Second operand</input_port>
        </Condition>
        <Action ID="ConcatenateStrings">
            <input_port type="std::string" name="first">First string</input_port>
            <output_port type="std::string" name="output">Concatenated result string</output_port>
            <input_port type="std::string" name="second">Second string</input_port>
        </Action>
        <Action ID="ConvertJsonToDouble">
            <input_port type="nlohmann::basic_json&lt;std::map, std::vector, std::__cxx11::basic_string&lt;char, std::char_traits&lt;char>, std::allocator&lt;char> >, bool, long, unsigned long, double, std::allocator, nlohmann::adl_serializer>" name="input">Serialized ROS message</input_port>
            <output_port type="double" name="output">Output variable</output_port>
