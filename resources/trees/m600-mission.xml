<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Action takeoff_height.data="6.0" state="tos" ID="UPOTakeOff" action="/TakeOff"/>
            <Action ID="WaitSeconds" duration="3"/>
            <ForceSuccess>
                <SubTree ID="FireOutsideMission"/>
            </ForceSuccess>
            <ForceSuccess>
                <SubTree ID="LeftFacadeMission"/>
            </ForceSuccess>
            <Action ID="WaitSeconds" duration="3"/>
            <RetryUntilSuccesful num_attempts="2">
                <SubTree waypoint="m600_home" ID="GoToAndLand"/>
            </RetryUntilSuccesful>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="BlanketExploreAndExtinguish">
        <SequenceStar>
            <Parallel threshold="1">
                <SubTree ID="OutsideExplorationPath"/>
                <Action x="fd_x" y="fd_y" fire_found="fd_found" z="fd_z" state="fd_s" ID="UPOFireDetection3D" action="/firedetection3D_bottom" duration="120" name="DetectFire"/>
            </Parallel>
            <Condition input="${fd_found}" ID="CheckBool"/>
            <Action message="${fd_found}" ID="InfoLog"/>
            <Action operator="+" output="final_z" second="3.0" first="${fd_z}" ID="MathOperationFloat"/>
            <Action ID="WaitSeconds" duration="3"/>
            <Action global_goal.pose.position.y="${fd_y}" global_goal.pose.orientation.w="1.0" global_goal.pose.orientation.y="0.0" global_goal.pose.orientation.z="0.0" global_goal.pose.position.x="${fd_x}" state="gtfs" global_goal.pose.position.z="${final_z}" ID="UPOGoToGoal" action="/Make_Plan" global_goal.header.frame_id="/world" name="GoToFire" global_goal.header.seq="1" global_goal.pose.orientation.x="0.0"/>
            <Action ID="WaitSeconds" duration="3"/>
            <Action detect_fire="true" state="ef_s" serialized_feedback="ef_f" serialized_result="ef_r" ID="UPOFireExtinguish" action="/blanket_fire_extinguisher" name="ExtinguishFire"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckFireAndExtinguish">
        <Sequence>
            <Action ID="WaitSeconds" duration="3"/>
            <Action goal_name="${fire}" state="gts" ID="UPOGoToGoalByName" action="${actgoto}" name="GoToFire"/>
            <Action detect_fire="true" state="fes" serialized_feedback="fef" serialized_result="fer" ID="UPOFireExtinguish" action="${actextinguish}" name="ExtinguishFire"/>
            <SetBlackboard value="${fire}" output_key="found_fire"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckResetRequest">
        <Sequence>
            <SetBlackboard value="false" output_key="reset_requested"/>
            <Action topic="/reset" consume_msgs="true" ID="MonitorStdBool" queue_size="1" serialized_output="m_reset"/>
            <Action output="mission_reset" input="${m_reset}" ID="ConvertMessageField" field="/data"/>
            <Action message="${mission_reset}" ID="InfoLog"/>
            <Condition input="${mission_reset}" ID="CheckBool"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="ExtinguishFacadeFire">
        <Sequence>
            <SetBlackboard value="none" output_key="fire_found"/>
            <ForceSuccess>
                <SubTree actextinguish="/wall_fire_extinguisher" actgoto="/Make_Plan" fire="floor_1_fire_1" ID="CheckFireAndExtinguish" found_fire="fire_found"/>
            </ForceSuccess>
            <Action goal_name="left_facade_retreat" state="lfrs" ID="UPOGoToGoalByName" action="/Make_Plan" name="GoToRetreat1"/>
            <Fallback>
                <SubTree actextinguish="/wall_fire_extinguisher" actgoto="/Make_Plan" fire="floor_2_fire_1" ID="CheckFireAndExtinguish" found_fire="fire_found"/>
                <Sequence>
                    <Action goal_name="left_facade_retreat" state="lfr2s" ID="UPOGoToGoalByName" action="/Make_Plan" name="GoToRetreat2"/>
                    <SubTree actextinguish="/wall_fire_extinguisher" actgoto="/Make_Plan" fire="floor_2_fire_2" ID="CheckFireAndExtinguish" found_fire="fire_found"/>
                </Sequence>
                <Sequence>
                    <Action goal_name="left_facade_retreat" state="lfr3s" ID="UPOGoToGoalByName" action="/Make_Plan"/>
                    <SubTree actextinguish="/wall_fire_extinguisher" actgoto="/Make_Plan" fire="floor_2_fire_3" ID="CheckFireAndExtinguish" found_fire="fire_found"/>
                </Sequence>
            </Fallback>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="FireOutsideMission">
        <SequenceStar>
            <Action goal_name="outside_explore_1" state="g1s" ID="UPOGoToGoalByName" action="/Make_Plan" name="GoToEntryPoint"/>
            <ForceSuccess>
                <SubTree ID="BlanketExploreAndExtinguish"/>
            </ForceSuccess>
            <Action ID="WaitSeconds" duration="5"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="GoToAndLand">
        <SequenceStar>
            <Action goal_name="${waypoint}" state="g1s" ID="UPOGoToGoalByName" action="/Make_Plan" name="GoToPointForLanding"/>
            <Action ID="WaitSeconds" duration="5"/>
            <Action state="lds" land="true" ID="UPOLanding" action="/Landing" name="Land"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="LeftFacadeMission">
        <SequenceStar>
            <Action goal_name="left_facade_approach_1" state="gts" ID="UPOGoToGoalByName" action="/Make_Plan" name="ApproachLeftFacade"/>
            <Action ID="WaitSeconds" duration="3"/>
            <ForceSuccess>
                <SubTree fire_found="fire_wp" ID="ExtinguishFacadeFire"/>
            </ForceSuccess>
            <Action message="${fire_wp}" ID="InfoLog"/>
            <Action ID="WaitSeconds" duration="3"/>
            <Action goal_name="left_facade_retreat" state="f2rs" ID="UPOGoToGoalByName" action="/Make_Plan" name="RetreatFromLeftFacade"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="OutsideExplorationPath">
        <Sequence>
            <Action ID="WaitSeconds" duration="3"/>
            <Action goal_name="outside_explore_2" state="gtg2s" ID="UPOGoToGoalByName" action="/Make_Plan" name="GoToGoal2"/>
            <Action ID="WaitSeconds" duration="3"/>
            <Action goal_name="outside_explore_3" state="gtg3s" ID="UPOGoToGoalByName" action="/Make_Plan" name="GoToGoal3"/>
            <Action ID="WaitSeconds" duration="3"/>
            <Action goal_name="outside_explore_4" state="gtg4s" ID="UPOGoToGoalByName" action="/Make_Plan" name="GoToGoal4"/>
            <Action ID="WaitSeconds" duration="3"/>
            <Action goal_name="outside_explore_5" state="gtg5s" ID="UPOGoToGoalByName" action="/Make_Plan" name="GoToGoal5"/>
            <Action ID="WaitSeconds" duration="3"/>
            <Action goal_name="outside_explore_6" state="gtg6s" ID="UPOGoToGoalByName" action="/Make_Plan" name="GoToGoal6"/>
            <Action ID="WaitSeconds" duration="3"/>
            <Action goal_name="outside_explore_7" state="gtg7s" ID="UPOGoToGoalByName" action="/Make_Plan" name="GoToGoal7"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <SubTree ID="BlanketExploreAndExtinguish"/>
