<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <SequenceStar>
            <Fallback>
                <SubTree door="floor_0_door_1" action="siar/Make_Plan" ID="CheckDoorandEnter" out_door="door_out" detection_action="/window_detector"/>
                <SubTree door="floor_0_door_2" action="siar/Make_Plan" ID="CheckDoorandEnter" out_door="door_out" detection_action="/window_detector"/>
            </Fallback>
            <Action ID="InfoLog" message="${door_out}"/>
            <ForceSuccess>
                <SubTree ID="Floor0SurveyAndExtinguish"/>
            </ForceSuccess>
            <RetryUntilSuccesful num_attempts="2">
                <SubTree robot_action="/siar/Make_Plan" ID="ExitBuilding" window="${door_out}"/>
            </RetryUntilSuccesful>
            <Action action="/siar/Make_Plan" name="GoToHome" goal_name="siar_home" state="gth_s" ID="UPOGoToGoalByName"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckDoorandEnter">
        <Sequence>
            <Action action="${action}" name="GoToWindow" goal_name="${door}" state="dummy" ID="UPOGoToGoalByName"/>
            <Action output="goal_in" name="GetGoalInside" second="_in" ID="ConcatenateStrings" first="${door}"/>
            <Action action="${action}" name="EnterThroughDoor" goal_name="${goal_in}" state="dummy" ID="UPOGoToGoalByName"/>
            <SetBlackboard value="${door}" name="WriteToMemory" output_key="out_door"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckFireAndExtinguish">
        <Sequence>
            <Action action="${actgoto}" goal_name="${fire}" state="gts" ID="UPOGoToGoalByName"/>
            <Action action="${actextinguish}" serialized_result="fer" detect_fire="true" state="fes" serialized_feedback="fef" ID="UPOFireExtinguish"/>
            <SetBlackboard value="${fire}" output_key="found_fire"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckResetRequest">
        <Sequence>
            <SetBlackboard value="false" output_key="reset_requested"/>
            <Action topic="/reset" queue_size="1" serialized_output="m_reset" ID="MonitorStdBool" consume_msgs="true"/>
            <Action field="/data" output="mission_reset" ID="ConvertMessageField" input="${m_reset}"/>
            <Action ID="InfoLog" message="${mission_reset}"/>
            <Condition ID="CheckBool" input="${mission_reset}"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="ExitBuilding">
        <SequenceStar>
            <Action output="goal_to_exit" name="PrepareToExit" second="_in_to_out" ID="ConcatenateStrings" first="${window}"/>
            <Action action="${robot_action}" name="GoToWindowOut" goal_name="${goal_to_exit}" state="gtwo_result" ID="UPOGoToGoalByName"/>
            <Action output="goal_outside" second="_out" ID="ConcatenateStrings" first="${window}"/>
            <Action action="${robot_action}" name="GoToExit" goal_name="${goal_outside}" state="gte_result" ID="UPOGoToGoalByName"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Floor0SurveyAndExtinguish">
        <SequenceStar>
            <SetBlackboard value="none" output_key="fire_found"/>
            <Fallback>
                <SubTree fire="floor_0_fire_1" ID="CheckFireAndExtinguish" actgoto="/siar/Make_Plan" actextinguish="/siar/siar_fire_extinguisher" found_fire="fire_found"/>
                <SubTree fire="floor_0_fire_2" ID="CheckFireAndExtinguish" actgoto="/siar/Make_Plan" actextinguish="/siar/siar_fire_extinguisher" found_fire="fire_found"/>
                <SubTree fire="floor_0_fire_3" ID="CheckFireAndExtinguish" actgoto="/siar/Make_Plan" actextinguish="/siar/siar_fire_extinguisher" found_fire="fire_found"/>
                <SubTree fire="floor_0_fire_4" ID="CheckFireAndExtinguish" actgoto="/siar/Make_Plan" actextinguish="/siar/siar_fire_extinguisher" found_fire="fire_found"/>
                <SubTree fire="floor_0_fire_5" ID="CheckFireAndExtinguish" actgoto="/siar/Make_Plan" actextinguish="/siar/siar_fire_extinguisher" found_fire="fire_found"/>
                <SubTree fire="floor_0_fire_6" ID="CheckFireAndExtinguish" actgoto="/siar/Make_Plan" actextinguish="/siar/siar_fire_extinguisher" found_fire="fire_found"/>
                <SubTree fire="floor_0_fire_7" ID="CheckFireAndExtinguish" actgoto="/siar/Make_Plan" actextinguish="/siar/siar_fire_extinguisher" found_fire="fire_found"/>
                <SubTree fire="floor_0_fire_8" ID="CheckFireAndExtinguish" actgoto="/siar/Make_Plan" actextinguish="/siar/siar_fire_extinguisher" found_fire="fire_found"/>
            </Fallback>
            <Action ID="InfoLog" message="${fire_found}"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="CallEmptyService">
            <input_port type="std::string" name="service">ROS service name</input_port>
        </Action>
        <Condition ID="CheckBool">
            <input_port type="bool" name="input">Input boolean value</input_port>
        </Condition>
        <SubTree ID="CheckDoorandEnter">
            <input_port name="action"/>
            <input_port name="detection_action"/>
            <input_port name="door"/>
            <output_port name="out_door"/>
        </SubTree>
        <SubTree ID="CheckFireAndExtinguish">
            <input_port name="actextinguish">Extinguish Action Name</input_port>
            <input_port name="actgoto">GoTo Action Name</input_port>
            <input_port name="fire">Fire waypoint</input_port>
            <output_port name="found_fire">Name of the Fire WP if found</output_port>
        </SubTree>
        <Action ID="CheckKey">
            <input_port type="std::string" name="no_key">Key to determine if key to say 'no' has benn pressed</input_port>
            <input_port type="std::string" name="yes_key">Key to determine if key to say 'yes' has been pressed</input_port>
        </Action>
        <SubTree ID="CheckResetRequest">
            <output_port name="reset_requested"/>
        </SubTree>
        <Condition ID="CompareNumbers">
            <input_port type="std::string" name="comparison_op">Comparison operator. Valid operators are &lt;, >, &lt;=, >=, == and !=</input_port>
            <input_port type="double" name="first">First operand</input_port>
            <input_port type="double" name="second">Second operand</input_port>
        </Condition>
        <Condition ID="CompareStrings">
            <input_port type="std::string" name="comparison_op">Comparison operator. Valid operators are &lt;, >, &lt;=, >=, == and !=</input_port>
            <input_port type="std::string" name="first">First operand</input_port>
            <input_port type="std::string" name="second">Second operand</input_port>
