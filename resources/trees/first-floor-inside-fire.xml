<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <ReactiveSequence>
            <Inverter>
                <SubTree ID="CheckResetRequest" reset_requested="is_reset"/>
            </Inverter>
            <Action message="${is_reset}" ID="InfoLog"/>
            <SequenceStar>
                <Fallback>
                    <SubTree ID="CheckWindowandEnter" window="floor_1_win_1" detection_action="/window_detector" out_win="window_out" action="/firefly1/Make_Plan"/>
                    <SubTree ID="CheckWindowandEnter" window="floor_1_win_2" detection_action="/window_detector" out_win="window_out" action="/firefly1/Make_Plan"/>
                </Fallback>
                <Action message="${window_out}" ID="InfoLog"/>
                <ForceSuccess>
                    <SubTree ID="Floor1ExploreAndExtinguish"/>
                </ForceSuccess>
                <RetryUntilSuccesful num_attempts="2">
                    <SubTree ID="ExitBuilding" window="${window_out}" robot_action="/Make_Plan"/>
                </RetryUntilSuccesful>
                <Action goal_name="m210_home" ID="UPOGoToGoalByName" state="gth_s" name="GoToHome" action="/Make_Plan"/>
            </SequenceStar>
        </ReactiveSequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckResetRequest">
        <Sequence>
            <SetBlackboard output_key="reset_requested" value="false"/>
            <Action serialized_output="m_reset" ID="MonitorStdBool" consume_msgs="true" queue_size="1" topic="/reset"/>
            <Action input="${m_reset}" ID="ConvertMessageField" field="/data" output="mission_reset"/>
            <Action message="${mission_reset}" ID="InfoLog"/>
            <Condition input="${mission_reset}" ID="CheckBool"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckWindowandEnter">
        <Sequence>
            <Action goal_name="${window}" ID="UPOGoToGoalByName" state="dummy" name="GoToWindow" action="${action}"/>
            <Action y="da_y" ID="UPOWindowDetection" state="da_s" window_present="da_wp" duration="5" x="da_x" action="${detection_action}" z="da_z"/>
            <Action first="${window}" ID="ConcatenateStrings" output="goal_in" name="GetGoalInside" second="_in"/>
            <Action goal_name="${goal_in}" ID="UPOGoToGoalByName" state="dummy" name="EnterThroughWindow" action="${action}"/>
            <SetBlackboard output_key="out_win" value="${window}" name="WriteToMemory"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="ExitBuilding">
        <SequenceStar>
            <Action first="${window}" ID="ConcatenateStrings" output="goal_to_exit" name="PrepareToExit" second="_in_to_out"/>
            <Action goal_name="${goal_to_exit}" ID="UPOGoToGoalByName" state="gtwo_result" name="GoToWindowOut" action="${robot_action}"/>
            <Action first="${window}" ID="ConcatenateStrings" output="goal_outside" second="_out"/>
            <Action goal_name="${goal_outside}" ID="UPOGoToGoalByName" state="gte_result" name="GoToExit" action="${robot_action}"/>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Floor1ExplorationPath">
        <Sequence>
            <Action goal_name="floor_1_explore_1" ID="UPOGoToGoalByName" state="gtg1s" name="GoToGoal1" action="/Make_Plan"/>
            <Action goal_name="floor_1_explore_2" ID="UPOGoToGoalByName" state="gtg2s" name="GoToGoal2" action="/Make_Plan"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Floor1ExploreAndExtinguish">
        <Sequence>
            <Parallel threshold="1">
                <SubTree ID="Floor1ExplorationPath"/>
                <Action fire_found="fd_found" y="fd_y" ID="UPOFireDetection3D" state="fd_s" duration="15" name="DetectFire" x="fd_x" action="/firedetection3D" z="fd_z"/>
            </Parallel>
            <Condition input="${fd_found}" ID="CheckBool"/>
            <Action message="${fd_found}" ID="InfoLog"/>
            <Action global_goal.header.frame_id="/world" global_goal.pose.orientation.w="1.0" global_goal.pose.position.z="${fd_z}" global_goal.pose.orientation.x="0.0" global_goal.pose.position.x="${fd_x}" ID="UPOGoToGoal" global_goal.pose.orientation.z="0.0" state="gtfs" global_goal.pose.orientation.y="0.0" global_goal.pose.position.y="${fd_y}" global_goal.header.seq="1" name="GoToFire" action="/Make_Plan"/>
            <Action detect_fire="true" ID="UPOFireExtinguish" serialized_result="ef_r" state="ef_s" serialized_feedback="ef_f" name="ExtinguishFire" action="/inside_fire_extinguisher"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="CallEmptyService">
            <input_port type="std::string" name="service">ROS service name</input_port>
        </Action>
        <Condition ID="CheckBool">
            <input_port type="bool" name="input">Input boolean value</input_port>
        </Condition>
        <Action ID="CheckKey">
            <input_port type="std::string" name="no_key">Key to determine if key to say 'no' has benn pressed</input_port>
            <input_port type="std::string" name="yes_key">Key to determine if key to say 'yes' has been pressed</input_port>
        </Action>
        <SubTree ID="CheckResetRequest">
            <output_port name="reset_requested"/>
        </SubTree>
        <SubTree ID="CheckWindowandEnter">
            <input_port name="action"/>
            <input_port name="detection_action"/>
            <output_port name="out_win"/>
            <input_port name="window"/>
        </SubTree>
        <Condition ID="CompareNumbers">
            <input_port type="std::string" name="comparison_op">Comparison operator. Valid operators are &lt;, >, &lt;=, >=, == and !=</input_port>
            <input_port type="double" name="first">First operand</input_port>
            <input_port type="double" name="second">Second operand</input_port>
        </Condition>
        <Condition ID="CompareStrings">
            <input_port type="std::string" name="comparison_op">Comparison operator. Valid operators are &lt;, >, &lt;=, >=, == and !=</input_port>
            <input_port type="std::string" name="first">First operand</input_port>
            <input_port type="std::string" name="second">Second operand</input_port>
        </Condition>
        <Action ID="ConcatenateStrings">
            <input_port type="std::string" name="first">First string</input_port>
            <output_port type="std::string" name="output">Concatenated result string</output_port>
            <input_port type="std::string" name="second">Second string</input_port>
        </Action>
        <Action ID="ConvertJsonToDouble">
