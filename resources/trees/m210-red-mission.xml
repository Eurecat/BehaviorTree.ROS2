<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Action state="toffs" takeoff_height.data="7.0" name="TakeOff" action="/TakeOff" ID="UPOTakeOff"/>
            <Action duration="3" ID="WaitSeconds"/>
            <ForceSuccess>
                <SequenceStar>
                    <Action state="gts" goal_name="right_facade_approach_1" name="ApproachRightFacade" action="/Make_Plan" ID="UPOGoToGoalByName"/>
                    <Action duration="3" ID="WaitSeconds"/>
                    <Action state="gt2s" goal_name="right_facade_approach_2" name="OrientToFacade" action="/Make_Plan" ID="UPOGoToGoalByName"/>
                    <ForceSuccess>
                        <SubTree fire_found="fire_wp" ID="ExtinguishFacadeFire"/>
                    </ForceSuccess>
                    <Action message="${fire_wp}" ID="InfoLog"/>
                    <Action duration="3" ID="WaitSeconds"/>
                    <Action state="f2rs" goal_name="right_facade_retreat" name="RetreatFromRightFacade" action="/Make_Plan" ID="UPOGoToGoalByName"/>
                </SequenceStar>
            </ForceSuccess>
            <RetryUntilSuccesful num_attempts="2">
                <SequenceStar>
                    <Action state="gths" goal_name="m210_red_home" name="GoToHome" action="/Make_Plan" ID="UPOGoToGoalByName"/>
                    <Action state="ls" land="true" action="/Landing" ID="UPOLanding"/>
                </SequenceStar>
            </RetryUntilSuccesful>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckFireAndExtinguish">
        <Sequence>
            <Action duration="3" ID="WaitSeconds"/>
            <Action state="gts" goal_name="${fire}" name="GoToFire" action="${actgoto}" ID="UPOGoToGoalByName"/>
            <Action serialized_result="fer" state="fes" name="ExtinguishFire" action="${actextinguish}" serialized_feedback="fef" ID="UPOFireExtinguish" detect_fire="true"/>
            <SetBlackboard output_key="found_fire" value="${fire}"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CheckResetRequest">
        <Sequence>
            <SetBlackboard output_key="reset_requested" value="false"/>
            <Action queue_size="1" serialized_output="m_reset" consume_msgs="true" ID="MonitorStdBool" topic="/reset"/>
            <Action input="${m_reset}" output="mission_reset" ID="ConvertMessageField" field="/data"/>
            <Action message="${mission_reset}" ID="InfoLog"/>
            <Condition input="${mission_reset}" ID="CheckBool"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="ExtinguishFacadeFire">
        <SequenceStar>
            <SetBlackboard output_key="fire_found" value="none"/>
            <ForceSuccess>
                <SubTree actgoto="/Make_Plan" fire="floor_1_fire_4" actextinguish="/wall_fire_extinguisher" ID="CheckFireAndExtinguish" found_fire="fire_found"/>
            </ForceSuccess>
            <Action state="gtrs" goal_name="right_facade_retreat" name="GoToRetreat" action="/Make_Plan" ID="UPOGoToGoalByName"/>
            <Fallback>
                <SubTree actgoto="/Make_Plan" fire="floor_2_fire_7" actextinguish="/wall_fire_extinguisher" ID="CheckFireAndExtinguish" found_fire="fire_found"/>
                <Sequence>
                    <Action state="gtr2s" goal_name="right_facade_retreat" name="GoToRetreat3" action="/Make_Plan" ID="UPOGoToGoalByName"/>
                    <SubTree actgoto="/Make_Plan" fire="floor_2_fire_8" actextinguish="/wall_fire_extinguisher" ID="CheckFireAndExtinguish" found_fire="fire_found"/>
                </Sequence>
                <Sequence>
                    <Action state="gtr3s" goal_name="right_facade_retreat" action="/Make_Plan" ID="UPOGoToGoalByName"/>
                    <SubTree actgoto="/Make_Plan" fire="floor_2_fire_9" actextinguish="/wall_fire_extinguisher" ID="CheckFireAndExtinguish" found_fire="fire_found"/>
                </Sequence>
            </Fallback>
        </SequenceStar>
    </BehaviorTree>
    <!-- ////////// -->
