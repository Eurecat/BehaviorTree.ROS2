<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="Test">
        <Sequence>
            <Repeat num_cycles="-1">
                <Fallback>
                    <Sequence>
                        <Sleep msec="2000"/>
                        <PublishStdEmpty topic_name="/emptyyy" name="A"/>
                        <PublishStdShort topic_name="/shooort" data="1" name="B"/>
                        <PublishStdBool topic_name="/asdf" data="1" name="C"/>
                        <MonitorStdBool topic_name="/asdf" name="D"/>
                        <PublishCustomMsg topic_name="/custom" value="1" name="E"/>
                        <MonitorCustomMsg topic_name="/custom" name="F"/>
                    </Sequence>
                    <AlwaysSuccess/>
                </Fallback>
            </Repeat>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <SubTree ID="BehaviorTree" description=""/>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
