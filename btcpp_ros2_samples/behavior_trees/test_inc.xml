<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <SetBlackboard output_key="sync_int" value="2000"/>
            <SetBlackboard output_key="sync_int2" value="2000"/>
            <Repeat num_cycles="-1">
                <Fallback>
                    <Sequence>
                        <Sleep msec="$${sync_int}"/>
                        <Sleep msec="$${sync_int2}"/>
                    </Sequence>
                    <AlwaysSuccess/>
                </Fallback>
            </Repeat>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <SubTree ID="BehaviorTree" description=""/>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
