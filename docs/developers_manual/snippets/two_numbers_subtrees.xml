<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Decorator ID="Loop">
            <Sequence>
                <Action ID="DemoMonitorTwoNumbers" serialize="true" key="message" topic="/tree_test/two_numbers" queue_size="1"/>
                <Fallback>
                    <Sequence>
                        <Action ID="GetMessageField" serialize="${message_serialized}" output="first_number" field="/numbers/0/data"/>
                        <Action ID="GetMessageField" serialize="${message_serialized}" output="second_number" field="/numbers/1/data"/>
                        <SubTree ID="CompareTwoNumbers"/>
                        <Action ID="DemoPublishString" latch="false" data="${result_sentence}" topic="/tree_test/result" queue_size="1"/>
                    </Sequence>
                    <Decorator ID="CooldownSeconds" cooldown_time="1">
                        <Action ID="DemoPublishString" latch="false" data="Are you gonna publish or not?" topic="/tree_test/result" queue_size="1"/>
                    </Decorator>
                </Fallback>
            </Sequence>
        </Decorator>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="CompareTwoNumbers">
        <Fallback>
            <Fallback>
                <Sequence>
                    <Condition ID="CompareNumbers" first="${first_number}" comparison_op="&gt;" second="${second_number}"/>
                    <Action ID="ConcatenateStrings" delimiter=";" input_strings="The biggest number is ;${first_number}" output_key="result_sentence"/>
                <Sequence>
                <Sequence>
                    <Condition ID="CompareNumbers" first="${second_number}" comparison_op="&gt;" second="${first_number}"/>
                    <Action ID="ConcatenateStrings" delimiter=";" input_strings="The biggest number is ;${seconds_number}" output_key="result_sentence"/>
                <Sequence>
            </Fallback>
            <SetBlackboard value="Both are the same! Woow!" key="result_sentence"/>
        </Fallback>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Decorator ID="Loop"/>
        <Decorator ID="CooldownSeconds">
            <input_port default="0" type="unsigned int" name="cooldown">Cooldown time</input_port>
        </Decorator>
         <Condition ID="CompareNumbers">
            <input_port type="std::string" name="comparison_op">Comparison operator. Valid operators are &lt;, >, &lt;=, >=, == and !=</input_port>
            <input_port type="double" name="first">First operand</input_port>
            <input_port type="double" name="second">Second operand</input_port>
        </Condition>
        <Action ID="ConcatenateStrings">
            <input_port type="std::string" name="delimiter"></input_port>
            <output_port type="std::string" name="output_key"></output_port>
            <input_port type="std::string" name="input_strings"></input_port>
        </Action>
        <Action ID="GetMessageField">
            <input_port type="std::string" name="field">Field to fetch</input_port>
            <input_port type="nlohmann::basic_json&lt;std::map, std::vector, std::__cxx11::basic_string&lt;char, std::char_traits&lt;char>, std::allocator&lt;char> >, bool, long, unsigned long, double, std::allocator, nlohmann::adl_serializer>" name="input">Serialized ROS message</input_port>
            <output_port type="BT::Any" name="output">Output variable</output_port>
        </Action>
        <Action ID="DemoPublishString">
            <input_port type="std::string" name="data">Auto-generated field from std_msgs::String_&lt;std::allocator&lt;void> ></input_port>
            <input_port type="bool" name="latch" default="0">Latch messages?</input_port>
            <input_port type="unsigned int" name="queue_size" default="1">Internal publisher queue size</input_port>
            <input_port type="std::string" name="topic">Topic to publish to</input_port>
        </Action>
        <Action ID="DemoMonitorTwoNumbers">
            <input_port type="std::string" name="key"></input_port>
            <input_port type="bool" name="serialized" default="0"></input_port>
            <input_port type="unsigned int" name="queue_size" default="1"></input_port>
            <input_port type="std::string" name="topic"></input_port>
        </Action>
        <SubTree ID="CompareTwoNumbers"/>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
