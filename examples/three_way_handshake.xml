<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <include path="palettes/behavior_tree_ros_palette.xml" ros_pkg="behavior_tree_ros"/>
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <SetBlackboard output_key="seq_id" value="0"/>
            <Loop>
                <Sequence>
                    <WaitSeconds duration="2"/>
                    <Action ID="BTCommandHandShakeAction" action="/behavior_tree/handshake" request.data=" " request.message="TEST" request.seq_id="${seq_id}" serialized_feedback="${feed}" serialized_result="${res}" state="${state}"/>
                    <MathOperationShort first="${seq_id}" operator="+" output="${seq_id}" second="1"/>
                </Sequence>
            </Loop>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <SubTree ID="BehaviorTree" description=""/>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
